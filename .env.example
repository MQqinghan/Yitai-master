# ============================================================
# Yitai 商城 · 环境变量模板（复制为 .env 后按需填写）
# 说明：所有变量都带默认值，不填也能本地直接跑（mock + localhost）。
#       docker compose / 容器化部署时，在 compose 里注入同名变量即可。
# ============================================================

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# ---- Redis ----
REDIS_HOST=localhost

# ---- Nacos ----
NACOS_HOST=localhost

# ---- Elasticsearch ----
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# ---- MinIO（对象存储，manager 上传用）----
MINIO_HOST=localhost
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- AI 服务（service-ai）----
# provider: mock（无需 key 即跑，规则兜底） | openai（真实大模型）
AI_PROVIDER=mock
# OpenAI 兼容协议 base-url（以下为通义千问兼容模式示例，可换 DeepSeek 等）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_API_KEY=your-api-key-here
AI_MODEL=deepseek-v4-flash
