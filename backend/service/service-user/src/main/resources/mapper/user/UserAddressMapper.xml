<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yitai.user.mapper.UserAddressMapper">

    <!--//根据id获取收货地址信息-->
    <select id="getUserAddress" resultType="com.yitai.model.entity.user.UserAddress">
        select *
        from user_address
        where id = #{id}
    </select>

    <!--//获取用户地址列表-->
    <select id="findUserAddressList" resultType="com.yitai.model.entity.user.UserAddress">
        select *
        from user_address
        where user_id = #{userId}
    </select>

    <!--保存用户地址-->
    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        insert into user_address (
            user_id,
            name,
            phone,
            tag_name,
            province_code,
            city_code,
            district_code,
            address,
            full_address,
            is_default
        ) values (
            #{userId},
            #{name},
            #{phone},
            #{tagName},
            #{provinceCode},
            #{cityCode},
            #{districtCode},
            #{address},
            #{fullAddress},
            #{isDefault}
        )
    </insert>

    <!--更新用户地址-->
    <update id="update">
        update user_address
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="phone != null and phone != ''">phone = #{phone},</if>
            <if test="tagName != null and tagName != ''">tag_name = #{tagName},</if>
            <if test="provinceCode != null and provinceCode != ''">province_code = #{provinceCode},</if>
            <if test="cityCode != null and cityCode != ''">city_code = #{cityCode},</if>
            <if test="districtCode != null and districtCode != ''">district_code = #{districtCode},</if>
            <if test="address != null and address != ''">address = #{address},</if>
            <if test="fullAddress != null and fullAddress != ''">full_address = #{fullAddress},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
        </set>
        where id = #{id}
    </update>

    <!--删除用户地址-->
    <delete id="delete">
        delete from user_address where id = #{id}
    </delete>
</mapper>